<?xml version="1.0" encoding="UTF-8"?>
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    <content url="file://$MODULE_DIR$">
      <sourceFolder url="file://$MODULE_DIR$/src" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/resources" type="java-resource" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
    <orderEntry type="module" module-name="shared" />
    <!-- client needs mirth-client.jar for UI/provider classes; mirth-server
         library is added so donkey-server.jar (Purgable) is resolvable when
         the shared module's TransmissionModeProperties is loaded. -->
    <orderEntry type="library" name="mirth-client" level="project" />
    <orderEntry type="library" name="mirth-server" level="project" />
  </component>
</module>
