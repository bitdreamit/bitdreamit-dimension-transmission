<?xml version="1.0" encoding="UTF-8"?>
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    <content url="file://$MODULE_DIR$">
      <sourceFolder url="file://$MODULE_DIR$/src" isTestSource="true" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
    <orderEntry type="module" module-name="shared" />
    <orderEntry type="module" module-name="server" />
    <!-- Purgable lives in donkey-server.jar inside the mirth-server library;
         needed to resolve TransmissionModeProperties in the shared module. -->
    <orderEntry type="library" name="mirth-server" level="project" />
    <orderEntry type="library" name="junit-4" level="project" />
  </component>
</module>
