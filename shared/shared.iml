<?xml version="1.0" encoding="UTF-8"?>
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    <content url="file://$MODULE_DIR$">
      <sourceFolder url="file://$MODULE_DIR$/src" isTestSource="false" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
    <!-- shared needs mirth-client-core.jar (for TransmissionModeProperties,
         FrameModeProperties, DataTypePropertyDescriptor) AND donkey-server.jar
         (for com.mirth.connect.donkey.util.purge.Purgable, which
         TransmissionModeProperties implements). The mirth-server project
         library already bundles both jars, so we add it here. -->
    <orderEntry type="library" name="mirth-server" level="project" />
    <orderEntry type="library" name="mirth-client" level="project" />
  </component>
</module>
